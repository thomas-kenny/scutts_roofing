:javascript
  var openMobileButton = document.querySelector('.open-mobile-menu')
  var closeMobileButton = document.querySelector('.close-mobile-menu')

  if (openMobileButton && closeMobileButton) {
    openMobileButton.addEventListener('click', showMobileMenu)
    closeMobileButton.addEventListener('click', closeMobileMenu)
  }

  var roofReportVideo = document.querySelector('.roof-report-video video')
  var roofReportPlayButton = document.querySelector('.roof-report-video-play')
  var roofReportVideoCta = document.querySelector('.roof-report-video-cta')

  function playRoofReportVideo() {
    if (!roofReportVideo || !roofReportPlayButton) { return }
    roofReportVideo.setAttribute('controls', '')
    roofReportPlayButton.classList.add('hidden')
    roofReportVideo.play()
    roofReportVideo.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
  }

  if (roofReportVideo && roofReportPlayButton) {
    roofReportPlayButton.addEventListener('click', playRoofReportVideo)

    roofReportVideo.addEventListener('ended', function () {
      roofReportVideo.removeAttribute('controls')
      roofReportVideo.currentTime = 0
      roofReportPlayButton.classList.remove('hidden')
    })
  }

  if (roofReportVideoCta) {
    roofReportVideoCta.addEventListener('click', function (event) {
      event.preventDefault()
      playRoofReportVideo()
    })
  }

  function showMobileMenu() {
    var mobileNav = document.querySelector('#mobile-nav')
    if (!mobileNav) { return }
    mobileNav.classList.remove('hidden')
    openMobileButton.classList.add('hidden')
    document.querySelector('.desktop-navbar').classList.add('hidden')
  }

  function closeMobileMenu() {
    var mobileNav = document.querySelector('#mobile-nav')
    if (!mobileNav) { return }
    mobileNav.classList.add('hidden')
    openMobileButton.classList.remove('hidden')
    document.querySelector('.desktop-navbar').classList.remove('hidden')
  }
